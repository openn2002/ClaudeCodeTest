# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Meta Ads API ──────────────────────────────────────────────────────────────
# Create a Meta Business App at developers.facebook.com
# Add the Marketing API product, create a System User, generate an access token
# with ads_read permission, and find your Ad Account ID in Meta Ads Manager.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# ── Slack ─────────────────────────────────────────────────────────────────────
# Create a Slack App at api.slack.com/apps
# Add Bot Token Scopes: chat:write, chat:write.public
# Install to workspace and copy the Bot User OAuth Token
# Get your Signing Secret from Basic Information > App Credentials
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=#marketing-alerts

# ── Slack Webhook Server ──────────────────────────────────────────────────────
# The public URL where your slack_webhook.py server is reachable
# (use ngrok for local development: ngrok http 8502)
SLACK_WEBHOOK_BASE_URL=http://localhost:8502
SLACK_WEBHOOK_PORT=8502
